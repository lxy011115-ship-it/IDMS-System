NODE_ENV=production
# Legacy Compose skeleton; production gate intentionally refuses startup until acceptance.
# The actual local manager provisions private database/identity settings and sets these itself.
IDMS_AUTH_MODE=oidc
IDMS_OIDC_ISSUER=http://127.0.0.1:8081/realms/idms
IDMS_OIDC_CLIENT_ID=idms-web
IDMS_OIDC_AUDIENCE=idms-api
IDMS_PUBLIC_ORIGIN=http://127.0.0.1:4010
IDMS_STORAGE=postgres
PORT=4010
APP_PUBLIC_ORIGIN=http://localhost:4010
DATABASE_URL=postgres://idms_app:change-me@postgres:5432/idms_control
TIMESCALE_DATABASE_URL=postgres://idms_app:change-me@timescaledb:5432/idms_telemetry
KEYCLOAK_ISSUER=http://keycloak:8080/realms/idms
KEYCLOAK_AUDIENCE=idms-api
MQTT_URL=mqtt://emqx:1883
MQTT_CLIENT_ID=idms-ingestion
MQTT_USERNAME=idms_ingestion
MQTT_PASSWORD=change-me
FLOWABLE_BASE_URL=http://flowable:8080/flowable-rest
FLOWABLE_USERNAME=admin
FLOWABLE_PASSWORD=change-me
AI_GATEWAY_URL=http://ai-gateway:8080/v1
AI_GATEWAY_MODEL=enterprise-default
AI_GATEWAY_API_KEY=change-me
AUDIT_SIGNING_KEY=replace-with-32-byte-secret

# Optional cached readiness; absent by default. Uses existing runtime objects and credentials.
# IDMS_READINESS_CONFIG=infra/runtime-readiness.example.json
