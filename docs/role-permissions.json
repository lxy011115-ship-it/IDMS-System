{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.2.0",
  "product": "IDMS",
  "description": "IDMS discrete manufacturing role and permission seed. Import into the authorization service or map to Keycloak realm roles.",
  "dataScopes": {
    "TENANT": "租户内全部数据",
    "SITE": "指定工厂及下属车间/产线/设备",
    "LINE": "指定产线及下属设备",
    "OWN_TASKS": "本人创建或被分派的任务",
    "READONLY_TENANT": "租户内只读数据"
  },
  "permissionCatalog": [
    {"code":"overview:read","name":"查看运营总览","risk":"LOW"},
    {"code":"device:read","name":"查看设备与测点","risk":"LOW"},
    {"code":"device:manage","name":"维护设备台账与测点配置","risk":"MEDIUM"},
    {"code":"telemetry:read","name":"查看遥测与趋势","risk":"LOW"},
    {"code":"telemetry:ingest","name":"写入遥测数据","risk":"HIGH"},
    {"code":"alarm:read","name":"查看报警","risk":"LOW"},
    {"code":"alarm:ack","name":"确认报警","risk":"MEDIUM"},
    {"code":"alarm:assign","name":"派发维修任务","risk":"MEDIUM"},
    {"code":"alarm:repair","name":"登记维修、复机与原因措施","risk":"MEDIUM"},
    {"code":"alarm:final-approve","name":"报警/维修最终关单","risk":"CRITICAL","requiresHuman":true},
    {"code":"maintenance:manage","name":"管理点检保养计划","risk":"MEDIUM"},
    {"code":"maintenance:execute","name":"执行点检保养任务","risk":"MEDIUM"},
    {"code":"quality:read","name":"查看质量与SPC","risk":"LOW"},
    {"code":"quality:manage","name":"配置质量特性与控制限","risk":"HIGH"},
    {"code":"quality:release","name":"质量异常关闭/产品放行","risk":"CRITICAL","requiresHuman":true},
    {"code":"spare:manage","name":"管理备件与库存关联","risk":"MEDIUM"},
    {"code":"report:read","name":"查看报表","risk":"LOW"},
    {"code":"report:export","name":"导出报表和业务数据","risk":"MEDIUM"},
    {"code":"knowledge:read","name":"检索知识库","risk":"LOW"},
    {"code":"knowledge:write","name":"创建/编辑知识草稿","risk":"MEDIUM"},
    {"code":"knowledge:publish","name":"发布知识条目","risk":"HIGH","requiresHuman":true},
    {"code":"template:read","name":"查看模板版本","risk":"LOW"},
    {"code":"template:edit","name":"编辑企业模板草稿","risk":"HIGH"},
    {"code":"template:submit","name":"提交并冻结模板草稿","risk":"HIGH","requiresHuman":true},
    {"code":"template:publish","name":"发布模板/流程/规则/指标","risk":"CRITICAL","requiresHuman":true},
    {"code":"plugin:read","name":"查看插件","risk":"LOW"},
    {"code":"plugin:submit","name":"提交插件认证","risk":"MEDIUM"},
    {"code":"plugin:certify","name":"平台厂商插件认证（制品流水线待验收）","risk":"HIGH","requiresHuman":true},
    {"code":"plugin:activate","name":"激活已认证插件","risk":"CRITICAL","requiresHuman":true},
    {"code":"integration:manage","name":"配置企业系统接口","risk":"HIGH"},
    {"code":"user:manage","name":"管理用户、角色和数据范围","risk":"CRITICAL"},
    {"code":"tenant:manage","name":"管理租户、套餐和模块","risk":"CRITICAL"},
    {"code":"audit:read","name":"查看追溯审计","risk":"LOW"},
    {"code":"audit:export","name":"导出审计记录","risk":"HIGH"},
    {"code":"security:approve","name":"批准安全策略/权限提升/数据删除","risk":"CRITICAL","requiresHuman":true},
    {"code":"data-import:read","name":"查看授权范围上传批次与校验结果","risk":"LOW"},
    {"code":"data-import:template-read","name":"下载已发布上传模板","risk":"LOW"},
    {"code":"data-import:upload","name":"上传文件或结构化数据至暂存区","risk":"MEDIUM"},
    {"code":"data-import:error-export","name":"导出授权范围逐行错误报告","risk":"MEDIUM"},
    {"code":"data-import:approve","name":"人工批准数据批次正式入库","risk":"CRITICAL","requiresHuman":true}
  ],
  "roles": [
    {"key":"tenant-admin","name":"租户管理员","description":"负责企业配置、模板草稿与插件清单提交；不得修改审计或自行终审。","dataScope":"TENANT","permissions":["overview:read","device:read","device:manage","telemetry:read","alarm:read","maintenance:manage","quality:read","spare:manage","report:read","report:export","knowledge:read","template:read","template:edit","template:submit","plugin:read","plugin:submit","integration:manage","user:manage","audit:read","audit:export"],"deny":["telemetry:ingest","alarm:final-approve","quality:release","template:publish","plugin:certify","plugin:activate","security:approve"]},
    {"key":"equipment-admin","name":"设备管理员","description":"维护设备资产、测点、维护计划和设备指标。","dataScope":"SITE","permissions":["overview:read","device:read","device:manage","telemetry:read","alarm:read","alarm:ack","alarm:assign","maintenance:manage","maintenance:execute","spare:manage","report:read","knowledge:read","audit:read"],"deny":["telemetry:ingest","alarm:final-approve","quality:release","template:publish","plugin:activate"]},
    {"key":"maintenance-engineer","name":"维修工程师","description":"处理报警、维修任务、复机验证和原因措施。","dataScope":"LINE","permissions":["overview:read","device:read","telemetry:read","alarm:read","alarm:ack","alarm:repair","maintenance:execute","spare:manage","report:read","knowledge:read","knowledge:write","audit:read"],"deny":["alarm:final-approve","quality:release","template:publish","plugin:activate"]},
    {"key":"production-supervisor","name":"生产主管","description":"关注产量、工单、节拍、停机和生产任务分配。","dataScope":"SITE","permissions":["overview:read","device:read","telemetry:read","alarm:read","alarm:ack","alarm:assign","report:read","report:export","audit:read"],"deny":["alarm:final-approve","quality:release"]},
    {"key":"quality-engineer","name":"质量工程师","description":"配置 SPC、质量特性、控制限和质量异常处置。","dataScope":"SITE","permissions":["overview:read","device:read","telemetry:read","alarm:read","quality:read","quality:manage","report:read","report:export","knowledge:read","knowledge:write","audit:read"],"deny":["quality:release","alarm:final-approve","template:publish"]},
    {"key":"operator","name":"操作员","description":"执行本人或班组范围的点检、报障和生产确认。","dataScope":"OWN_TASKS","permissions":["overview:read","device:read","alarm:read","alarm:ack","maintenance:execute","quality:read","report:read","knowledge:read"],"deny":["device:manage","alarm:assign","alarm:final-approve","quality:release","template:publish","plugin:activate"]},
    {"key":"spare-parts-clerk","name":"备件管理员","description":"管理备件、适配设备和更换记录。","dataScope":"SITE","permissions":["device:read","alarm:read","spare:manage","report:read","report:export","audit:read"],"deny":["alarm:final-approve","quality:release"]},
    {"key":"final-approver","name":"业务终审员","description":"只负责授权范围最终责任批准；数据入库还须匹配业务类型授权，不得批准本人上传。","dataScope":"SITE","permissions":["overview:read","device:read","alarm:read","alarm:final-approve","quality:read","quality:release","knowledge:read","knowledge:publish","template:read","template:publish","plugin:read","plugin:activate","audit:read","audit:export","data-import:read","data-import:approve"],"deny":["user:manage","tenant:manage","security:approve","telemetry:ingest","data-import:upload"]},
    {"key":"auditor","name":"审计员","description":"只读查看业务、AI、审批、接口和配置追溯。","dataScope":"READONLY_TENANT","permissions":["overview:read","device:read","telemetry:read","alarm:read","quality:read","report:read","report:export","knowledge:read","template:read","plugin:read","audit:read","audit:export","data-import:read"],"deny":["telemetry:ingest","alarm:ack","alarm:assign","alarm:repair","alarm:final-approve","quality:release","template:publish","plugin:activate","data-import:upload","data-import:approve"]},
    {"key":"data-uploader","name":"数据上传专员","description":"下载模板、上传与修正本工厂数据；上传前另须业务类型授权，禁止终审和直接写正式数据。","dataScope":"SITE","permissions":["device:read","data-import:read","data-import:template-read","data-import:upload","data-import:error-export"],"deny":["data-import:approve","alarm:final-approve","quality:release","telemetry:ingest","template:publish","plugin:activate"]},
    {"key":"platform-certifier","name":"平台插件认证员","description":"平台厂商侧插件认证，非租户管理员；当前仅建角色，制品认证/沙箱完成前仍拒绝认证运行。","dataScope":"TENANT","permissions":["plugin:read","plugin:certify","audit:read"],"deny":["template:publish","plugin:activate","alarm:final-approve","quality:release","data-import:approve"]},
    {"key":"system-admin","name":"平台系统管理员","description":"目标为平台运维角色；当前运行时只读，叠加业务角色也不获得终审权限。","dataScope":"TENANT","permissions":["overview:read","user:manage","tenant:manage","integration:manage","audit:read","audit:export"],"deny":["alarm:final-approve","quality:release","template:publish","plugin:certify","plugin:activate","security:approve"]}
  ],
  "policies": [
    {"key":"deny-final-actions-to-ai","effect":"DENY","subject":"AI","permissions":["alarm:final-approve","quality:release","knowledge:publish","template:publish","plugin:activate","security:approve","data-import:approve"]},
    {"key":"deny-import-approval-to-interfaces","effect":"DENY","subject":"INTERFACE","permissions":["data-import:approve"]},
    {"key":"deny-import-self-approval","effect":"DENY","subject":"ALL","permissions":["data-import:approve"],"condition":"approval actor must differ from uploader and must be an authorized human"},
    {"key":"require-import-business-scope","effect":"REQUIRE","subject":"ALL","permissions":["data-import:upload","data-import:approve"],"condition":"tenant, site/line scope and approved per-data-type grants must match every row"},
    {"key":"deny-device-control","effect":"DENY","subject":"ALL","permissions":["device:control","plc:write","opcua:write","mqtt:command"]},
    {"key":"audit-required-for-writes","effect":"REQUIRE","subject":"ALL","permissions":["*"],"condition":"all write operations must append an audit event and carry correlation_id"}
  ]
}
