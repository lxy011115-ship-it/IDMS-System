{
  "openapi":"3.0.3",
  "info":{"title":"IDMS 预测维护与维修接口（当前开发实现）","version":"0.4.0","description":"完整平台为真实OIDC/PKCE后端会话或Bearer访问令牌；仅独立文件Demo使用演示身份头。不能公开部署，生产门禁仍锁定。会话写请求另需固定Origin与X-CSRF-Token。权限映射见authentication-guide.md。业务接口在事务成功后返回200。RUL和故障概率未评估为null；工程阈值不是经验证预测模型。"},
  "servers":[{"url":"http://127.0.0.1:4010/api/v1"}],
  "security":[{"bearerAuth":[]},{"sessionCookie":[]}],
  "paths":{
    "/predictive/overview":{"get":{"description":"返回每设备最新健康结果、预测告警、建议、模型、工单；预置场景与批准数据分析必须区分。","responses":{"200":{"description":"租户内结果"},"401":{"description":"无效租户"},"403":{"description":"身份未授权"}}}},
    "/predictive/health":{"get":{"responses":{"200":{"description":"租户内健康快照历史"}}}},
    "/predictive/alerts":{"get":{"responses":{"200":{"description":"租户内告警列表"}}}},
    "/predictive/models":{"get":{"responses":{"200":{"description":"模型版本列表；预置评测数字仅为样例"}}}},
    "/predictive/analyze":{"post":{"description":"需analyze权限，包含上传专员、终审员、设备管理员或维修工程师；只读取已批准的MEASUREMENT；失败返回HUMAN_REVIEW并记录审计，不能伪造健康结果。去重包括输入与模型版本。","parameters":[{"$ref":"#/components/parameters/Key"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["deviceCode"],"properties":{"deviceCode":{"type":"string","example":"D-001"}}}}}},"responses":{"200":{"description":"{status:ANALYZED,snapshot,reused} 或 {status:HUMAN_REVIEW,reason,snapshot:null}"},"404":{"description":"设备台账未批准"},"409":{"description":"幂等键或数据库修订冲突"}}}},
    "/predictive/alerts/{id}/approval":{"post":{"description":"final-approver真实用户批准创建UNASSIGNED工单，维修工程师需领取；APPROVED不表示维修完成或设备放行。文件Demo保留旧派工行为。","parameters":[{"$ref":"#/components/parameters/Key"},{"$ref":"#/components/parameters/Id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["decision","comment","expectedVersion"],"properties":{"decision":{"type":"string","enum":["APPROVED","RETURNED"]},"comment":{"type":"string","minLength":2,"maxLength":2000},"expectedVersion":{"type":"integer","minimum":1}}}}}},"responses":{"200":{"description":"告警，含workOrderId"},"403":{"description":"非终审员"},"404":{"description":"当前租户不存在"},"409":{"description":"状态、版本或幂等冲突"}}}},
    "/work-orders":{"get":{"responses":{"200":{"description":"租户内工单items/total；当前开发实现无服务器分页"}}}},
    "/work-orders/{id}":{"get":{"parameters":[{"$ref":"#/components/parameters/Id"}],"responses":{"200":{"description":"工单含版本、验证快照、决定摘要"},"404":{"description":"当前租户内不存在"}}}},
    "/work-orders/{id}/claim":{"post":{"description":"需maintenance:execute；真实用户领取UNASSIGNED工单，或接收旧的未执行demo.*派工。负责人固定为令牌subject，不允许调用方指定其他人员。","parameters":[{"$ref":"#/components/parameters/Key"},{"$ref":"#/components/parameters/Id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Version"}}}},"responses":{"200":{"description":"ASSIGNED工单"},"403":{"description":"无维修执行权"},"409":{"description":"已领取或状态/版本冲突"}}}},
    "/work-orders/{id}/start":{"post":{"description":"仅被派工的维修工程师，可从ASSIGNED进入IN_PROGRESS。","parameters":[{"$ref":"#/components/parameters/Key"},{"$ref":"#/components/parameters/Id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Version"}}}},"responses":{"200":{"description":"更新工单"},"403":{"description":"非负责人或非用户"},"409":{"description":"状态/版本冲突"}}}},
    "/work-orders/{id}/submit":{"post":{"description":"仅负责人，冻结维修和复测证据后进入AWAITING_APPROVAL。","parameters":[{"$ref":"#/components/parameters/Key"},{"$ref":"#/components/parameters/Id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["expectedVersion","failureCode","cause","action","verification","minutes","partsUsed"],"properties":{"expectedVersion":{"type":"integer","minimum":1},"failureCode":{"type":"string","minLength":2},"cause":{"type":"string","minLength":2},"action":{"type":"string","minLength":2},"verification":{"type":"string","minLength":2},"minutes":{"type":"number","exclusiveMinimum":true,"minimum":0,"maximum":525600},"partsUsed":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":200}}}}}}},"responses":{"200":{"description":"工单含resolution.digest"},"400":{"description":"缺证据、耗时或备件无效"},"403":{"description":"非维修负责人"},"409":{"description":"状态/版本冲突"}}}},
    "/work-orders/{id}/approval":{"post":{"description":"仅独立终审员，禁止维修者自审和AI/接口身份；批准关单反馈告警，退回需重新提交证据。signature仅为决定内容摘要，不是CA电子签名。","parameters":[{"$ref":"#/components/parameters/Key"},{"$ref":"#/components/parameters/Id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["expectedVersion","snapshotDigest","decision","comment"],"properties":{"expectedVersion":{"type":"integer","minimum":1},"snapshotDigest":{"type":"string"},"decision":{"type":"string","enum":["APPROVED","RETURNED"]},"comment":{"type":"string","minLength":2,"maxLength":2000}}}}}},"responses":{"200":{"description":"CLOSED或IN_PROGRESS工单"},"403":{"description":"非独立终审员"},"409":{"description":"版本、状态、证据摘要或数据库冲突"}}}}
  },
  "components":{
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"},"sessionCookie":{"type":"apiKey","in":"cookie","name":"idms_session"}},
    "parameters":{"Key":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":128},"description":"同身份/租户/路径同键同输入返回原响应，不同输入409；建议附UUID X-Correlation-Id"},"Id":{"name":"id","in":"path","required":true,"schema":{"type":"string"}}},
    "schemas":{"Version":{"type":"object","required":["expectedVersion"],"properties":{"expectedVersion":{"type":"integer","minimum":1}}}}
  }
}
